# === Базовые настройки приложения ===
APP_NAME="Movie Recommender API"
APP_VERSION="0.1.0"

# === ArangoDB ===
# URL до ArangoDB из контейнера API / Celery / Airflow
ARANGO_URL="http://arangodb:8529"
# Имя БД для проекта
ARANGO_DB="movies"
# Пользователь и пароль (НЕ используйте root/password в проде)
ARANGO_USER="root"
ARANGO_PASSWORD="password"

# === Redis ===
# Подключение к Redis (внутри docker-compose сети)
REDIS_URL="redis://redis:6379/0"

# === Безопасность / JWT ===
# Секретный ключ для подписи JWT и других криптографических операций.
# В проде — длинная случайная строка (например, 32+ байта, сгенерировать openssl / pwgen).
SECRET_KEY="CHANGE_ME_TO_STRONG_RANDOM_VALUE"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# === A/B тестирование ===
# Seed для детерминированного разбиения пользователей по вариантам.
AB_SEED=42
# Вариант по умолчанию, если не удалось назначить (A/B)
DEFAULT_VARIANT="A"

# === Кэш рекомендаций ===
# TTL в часах для ключей rec:{user_id}:{algo}
REC_TTL_HOURS=1

# === Rate limiting ===
# Максимальное число запросов в минуту на одного пользователя (по JWT) или IP
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# === Демо-админ (для скрипта create_demo_admin.py) ===
DEMO_ADMIN_USERNAME="admin"
DEMO_ADMIN_PASSWORD="admin"